# Duração do leilão. Formato time.ParseDuration (ex: 20s, 5m, 1h).
# Fallback no código: 5m
AUCTION_INTERVAL=20s

# Batching de lances (bids)
# Fallbacks no código: 3m e 5
BATCH_INSERT_INTERVAL=20s
MAX_BATCH_SIZE=4

# MongoDB — consumidas pelo container "mongodb"
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin

# Conexão da aplicação.
# Dentro do Docker o host é "mongodb" (nome do serviço no compose).
# Para rodar fora do Docker, troque para localhost:27017.
MONGODB_URL=mongodb://admin:admin@mongodb:27017/auctions?authSource=admin
MONGODB_DB=auctions
